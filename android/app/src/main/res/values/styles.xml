<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme.
         windowBackground is set explicitly: the parent is a Light theme,
         whose default white window background was the earliest layer of
         the cold-start white screen. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">#020617</item>
        <item name="colorAccent">@color/colorAccent</item>

        <item name="android:windowBackground">#020617</item>
        <item name="android:colorBackground">#020617</item>

        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>

        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#020617</item>
        <item name="android:navigationBarColor">#020617</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:windowLayoutInDisplayCutoutMode">never</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="android:background">@null</item>
        <item name="android:windowBackground">#020617</item>

        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#020617</item>
        <item name="android:navigationBarColor">#020617</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:windowLayoutInDisplayCutoutMode">never</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>

        <!-- Android 12+ system splash: without this the splash background
             derives a light default, showing white before the app draws. -->
        <item name="windowSplashScreenBackground">#020617</item>
        <item name="android:windowBackground">@drawable/splash</item>

        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#020617</item>
        <item name="android:navigationBarColor">#020617</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:windowLayoutInDisplayCutoutMode">never</item>
    </style>

</resources>
